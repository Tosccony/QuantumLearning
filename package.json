{
  "name": "quantum-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:py": "backend/.venv/bin/python backend/test_engine.py",
    "check:js": "esbuild scripts/check.ts --bundle --platform=node --format=esm --outfile=dist/check.mjs --log-level=warning && node dist/check.mjs",
    "qollab:build": "bash scripts/build-qollab.sh",
    "qollab:smoke": "bash scripts/qollab-smoke/build.sh",
    "backend": "cd backend && .venv/bin/uvicorn main:app --port 8000 --reload",
    "backend:setup": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "framer-motion": "^14.1.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
